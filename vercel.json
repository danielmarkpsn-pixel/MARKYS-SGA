{
  "rewrites": [
    {
      "source": "/consultorio",
      "destination": "/consultorio.html"
    },
    {
      "source": "/consultorio/",
      "destination": "/consultorio.html"
    },
    {
      "source": "/admin-logins",
      "destination": "/admin-logins.html"
    },
    {
      "source": "/admin-logins/",
      "destination": "/admin-logins.html"
    },
    {
      "source": "/financeiro",
      "destination": "/financeiro.html"
    },
    {
      "source": "/financeiro/",
      "destination": "/financeiro.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.youtube.com https://s.ytimg.com; connect-src 'self' https://vibybosdqavejvqsuvph.supabase.co wss://vibybosdqavejvqsuvph.supabase.co https://vibybosdqavejvqsuvph.storage.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ]
}
